# Data lives on the GPU box, not in git. Only data/README.md is tracked.
data/*
!data/README.md

# Private to one machine: remote GPU host details and the script that syncs to it.
docs/remote_setup.md
scripts/sync_to_*.sh

# Paper PDFs are large and not ours to redistribute. papers/download_papers.sh fetches them.
papers/*.pdf

# Experiment outputs: keep the small summaries, drop the heavy artefacts.
results/**/checkpoints/
results/**/*.pt
results/**/*.safetensors
logs/

# Python
.venv/
__pycache__/
*.egg-info/
.ipynb_checkpoints/
.pytest_cache/

# OS / editor
.DS_Store
.vscode/
